# ESPN Fantasy (private leagues need cookies from a logged-in ESPN session)
ESPN_S2=paste_espn_s2_cookie_value_here
ESPN_SWID={PASTE-SWID-WITH-BRACES}
ESPN_LEAGUE_IDS=111111,222222,333333
ESPN_SEASON=2026

# Claude API (for weekly photo capture -> structured extraction)
ANTHROPIC_API_KEY=sk-ant-...

# Bill's Yahoo fantasy team name, used to identify his side of a matchup screenshot
YAHOO_TEAM_NAME=Who Drank All the Bitch Pops

# Railway volume mount path for persistent JSON storage (Railway sets this
# automatically if you attach a volume — otherwise defaults to ./data locally)
DATA_DIR=/data

PORT=3000
